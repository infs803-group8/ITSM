{
  "name": "itsm-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:api:browser": "playwright test --config playwright.api.config.ts",
    "test:auth:e2e": "playwright test --config playwright.auth.config.ts",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/generate-api.mjs --check",
    "mocks:worker": "msw init public --save",
    "check": "npm run api:check && npm run typecheck && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@tanstack/react-query": "^5.66.0",
    "antd": "6.6.5",
    "axios": "^1.7.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/node": "22.19.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "msw": "^2.7.0",
    "typescript": "~5.7.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.1",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser@1.4.4": {
      "js-yaml": "4.3.2"
    }
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
