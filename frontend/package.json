{
  "name": "itsm-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:api:browser": "playwright test --config playwright.api.config.ts",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/generate-api.mjs --check",
    "mocks:worker": "msw init public --save",
    "check": "npm run api:check && npm run typecheck && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "axios": "^1.7.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/node": "22.10.0",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.0.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "msw": "^2.7.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "yaml": "2.8.1"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
